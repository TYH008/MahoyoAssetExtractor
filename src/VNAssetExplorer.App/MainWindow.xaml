<Window x:Class="VNAssetExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Text[Title]}" Language="{Binding Text.Code, ConverterCulture=en-US}" Icon="Assets/app-icon.ico" Width="960" Height="640" MinWidth="600" MinHeight="400"
        FontFamily="Segoe UI" FontSize="16" Foreground="#E6EDF8" Background="#101B38">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedInk" Color="#AFC3DF"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="#21395F"/>
            <Setter Property="Foreground" Value="#F2F6FB"/>
            <Setter Property="BorderBrush" Value="#91AACB"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Stroke="#F4E5CB" StrokeThickness="2" RadiusX="7" RadiusY="7" Margin="-3"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter x:Name="ButtonContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#D6D6CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#172A49"/>
                                <Setter Property="Foreground" Value="#8EA4C3"/>
                                <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#AFC3DF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#102344"/>
            <Setter Property="Foreground" Value="#F2F5FB"/>
            <Setter Property="BorderBrush" Value="#829ABB"/>
            <Setter Property="CaretBrush" Value="#D3E8FF"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7EFFA"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#83BADE"/>
            <Setter Property="Background" Value="#172B51"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#E6EDF8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/VNAssetExplorer.App;component/Assets/starry-library-background.png" Stretch="Fill"/>
        </Grid.Background>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Grip" Background="#688CB4" CornerRadius="4"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#A8C7E3"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#D9E8F3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Background" Value="#142747"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="4,5"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb MinHeight="24"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" Margin="5,4"
                                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                               Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb><Thumb MinWidth="24"/></Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Resources>
        <Border Background="#D50A1732" BorderBrush="#B19C9AAA" BorderThickness="1" CornerRadius="18"
                Margin="42,28" Padding="30,22,30,25" MinWidth="550">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Label Content="{Binding Text[Language]}" Target="{Binding ElementName=LanguagePicker}"
                           VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" MinWidth="120" MinHeight="32"
                              VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text[Language]}"/>
                </StackPanel>
                <TextBlock Text="{Binding Text[GameTitle]}" FontFamily="Georgia,楷体,KaiTi" FontSize="29" Foreground="#F4E5CB"/>
                <TextBlock Text="{Binding Text[Subtitle]}" FontFamily="Georgia,楷体,KaiTi" FontSize="21" Foreground="#CFDCEE" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" IsEnabled="{Binding CanEdit}" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Content="{Binding Text[Source]}" Target="{Binding ElementName=SourceDirectoryBox}"/>
                <TextBox x:Name="SourceDirectoryBox" Grid.Row="1" Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text[Source]}"/>
                <Button x:Name="SourcePickerButton" Grid.Row="1" Grid.Column="1" Content="{Binding Text[Browse]}" Command="{Binding PickSourceCommand}" AutomationProperties.Name="{Binding Text[PickSource]}"/>
            </Grid>
            <Grid Grid.Row="2" IsEnabled="{Binding CanEdit}" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Content="{Binding Text[Output]}" Target="{Binding ElementName=OutputDirectoryBox}"/>
                <TextBox x:Name="OutputDirectoryBox" Grid.Row="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Text[Output]}"/>
                <Button x:Name="OutputPickerButton" Grid.Row="1" Grid.Column="1" Content="{Binding Text[Browse]}" Command="{Binding PickOutputCommand}" AutomationProperties.Name="{Binding Text[PickOutput]}"/>
            </Grid>
            <StackPanel Grid.Row="3" IsEnabled="{Binding CanEdit}" Margin="0,0,0,12">
                <TextBlock Text="{Binding Text[SelectCategories]}" FontFamily="楷体,KaiTi" FontSize="22" Margin="0,0,0,7"/>
                <TextBlock Text="{Binding Text[AllAssets]}" Foreground="{StaticResource MutedInk}"/>
                <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="ImagesCheckBox" Content="{Binding Text[AllImages]}" IsChecked="{Binding ImagesSelected}" Margin="4,8,24,8" AutomationProperties.Name="{Binding Text[AllImages]}"/>
                    <CheckBox x:Name="AudioCheckBox" Content="{Binding Text[AllAudio]}" IsChecked="{Binding AudioSelected}" Margin="4,8,24,8" AutomationProperties.Name="{Binding Text[AllAudio]}"/>
                    <CheckBox x:Name="VideoCheckBox" Content="{Binding Text[AllVideo]}" IsChecked="{Binding VideoSelected}" Margin="4,8,24,8" AutomationProperties.Name="{Binding Text[AllVideo]}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Text[Gallery]}" Foreground="{StaticResource MutedInk}"/>
                <WrapPanel>
                    <CheckBox x:Name="GalleryImagesCheckBox" Content="{Binding Text[GalleryImagesOption]}" IsChecked="{Binding GalleryImagesSelected}" Margin="4,8,24,8" AutomationProperties.Name="{Binding Text[GalleryImagesOption]}"/>
                    <CheckBox x:Name="GalleryAudioCheckBox" Content="{Binding Text[GalleryAudioOption]}" IsChecked="{Binding GalleryAudioSelected}" Margin="4,8,24,8" AutomationProperties.Name="{Binding Text[GalleryAudioOption]}"/>
                </WrapPanel>
            </StackPanel>
            <WrapPanel Grid.Row="4" Margin="0,0,0,16">
                <Button x:Name="StartButton" Content="{Binding Text[Start]}" Command="{Binding StartCommand}" Background="#80B1D3" Foreground="#0D2341" AutomationProperties.Name="{Binding Text[Start]}"/>
                <Button x:Name="CancelButton" Content="{Binding Text[Cancel]}" Command="{Binding CancelCommand}" AutomationProperties.Name="{Binding Text[Cancel]}"/>
                <Button x:Name="OpenOutputButton" Content="{Binding Text[OpenOutput]}" Command="{Binding OpenOutputCommand}" AutomationProperties.Name="{Binding Text[OpenOutput]}"/>
            </WrapPanel>
            <StackPanel Grid.Row="5" Background="Transparent" Margin="0,0,0,16">
                <TextBlock x:Name="StatusBlock" Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.Name="{Binding Text[Status]}"/>
                <ProgressBar x:Name="WorkProgressBar" Height="8" IsIndeterminate="{Binding IsIndeterminate}" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}"/>
                <TextBlock x:Name="ProgressBlock" Text="{Binding ProgressText}" Margin="0,8,0,0" AutomationProperties.Name="{Binding Text[Progress]}"/>
            </StackPanel>
            <TextBlock Grid.Row="6" Text="{Binding Text[Results]}" FontFamily="楷体,KaiTi" FontSize="20" Margin="0,0,0,8"/>
            <TextBlock x:Name="ResultsBlock" Grid.Row="7" Text="{Binding ResultText}" AutomationProperties.Name="{Binding Text[Results]}"/>
        </Grid>
        </Border>
    </ScrollViewer>
    </Grid>
</Window>
