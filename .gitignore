# Build output
[Bb]in/
[Oo]bj/
artifacts/
TestResults/
coverage/
*.trx

# IDE and editor local state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Packages and temporary files
packages/
*.nupkg
*.snupkg
*.tmp
*.temp
*.bak
*.log

# Local secrets and configuration
.env
.env.*
!.env.example
secrets/
*.pfx
